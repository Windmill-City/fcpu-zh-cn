{
  "name": "fcpu",
  "version": "0.4.44",
  "title": "fCPU",
  "description": "Factorio Customizable Processing Unit.\nAllow to write any logic on low level machine code.\nThe fCPU acts like a programmable microcontroller with a vector coprocessor that supports many useful instructions.",
  "author": "KonStg & Krul",
  "contact": "https://discord.gg/vPnDPhV",
  "homepage": "https://boosty.to/konstg",
  "factorio_version": "2.0",
  "dependencies": [
    "base >= 2.0",
    "? quality",
    "flib",
    "? informatron >= 0.1.13",
    "(?) booktorio >= 1.0.0",
    "? even-pickier-dollies >= 2.1.0",
    "(?) SchallCircuitGroup >= 2.0.0",
    "(?) compaktcircuit >= 2.0.0",
    "? BlueprintTools"
  ],
  "package": {
    "ignore": [ "tests/**", "*.psd", "todos.md"],
    "scripts": {
      "prepublish": "python .vscode/factorio-crowdin-sync",
      "version": "powershell -ExecutionPolicy Unrestricted .vscode/event_version.ps1",
      "compile": "powershell -ExecutionPolicy Unrestricted .vscode/event_compile.ps1"
    },
    "sync_portal_details": true
  }
}
