    "version": "0.2.0",
    "configurations": [
        {
            "type": "factoriomod",
            "request": "launch",
            "name": "Factorio Mod Debug",
            "factorioPath": "G:/SteamLibrary/steamapps/common/Factorio/bin/x64/factorio.exe"
        },
        {
            "name": "launch",
            "type": "lua",
            "request": "launch",
            "luaVersion": "5.2",
            "stopOnEntry": false,
            "stopOnThreadEntry": false,
            "program": "${workspaceFolder}/tests/fcpu.lua",
            "cwd": "${workspaceFolder}",
            "path": "?;?.lua;${workspaceFolder}/?.lua;${workspaceFolder}/tests/?.lua;${workspaceFolder}/src/?.lua",
            "cpath": "${workspaceFolder}/?.dll",
            "arg": [],
            "consoleCoding": "utf8"
        }
    ]
}