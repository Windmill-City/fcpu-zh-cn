{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "factoriomod",
            "request": "launch",
            "name": "Factorio Mod Debug",
            "factorioPath": "G:/SteamLibrary/steamapps/common/Factorio/bin/x64/factorio.exe",
            "hookData": true,
            "hookControl": ["fcpu"]
        },
        {
            "type": "factoriomod",
            "request": "launch",
            "name": "Factorio Mod Profile",
            "factorioPath": "G:/SteamLibrary/steamapps/common/Factorio/bin/x64/factorio.exe",
            "hookMode": "profile",
            "hookControl": ["fcpu"]
        },
        {
            "type": "factoriomod",
            "request": "launch",
            "name": "Factorio Mod Debug (custom modPath)",
            "factorioPath": "G:/SteamLibrary/steamapps/common/Factorio/bin/x64/factorio.exe",
            "modsPath": "S:/Work/KonStg/.factorio_mods",
            "hookData": true,
            "hookControl": ["fcpu"]
        },
        {
            "type": "factoriomod",
            "request": "launch",
            "name": "Factorio Mod Profile (custom modPath)",
            "factorioPath": "G:/SteamLibrary/steamapps/common/Factorio/bin/x64/factorio.exe",
            "modsPath": "S:/Work/KonStg/.factorio_mods",
            "hookMode": "profile",
            "hookControl": ["fcpu"]
        },
        {
            "name": "Convert Readme to Wiki",
            "type": "lua",
            "request": "launch",
            "luaVersion": "5.2",
            "stopOnEntry": false,
            "stopOnThreadEntry": false,
            "program": "${workspaceFolder}/tests/wiki.lua",
            "cwd": "${workspaceFolder}/src/wiki",
            "path": "?;?.lua;${workspaceFolder}/?.lua;${workspaceFolder}/src/?.lua",
            "cpath": "${workspaceFolder}/?.dll",
            "arg": ["${workspaceFolder}/readme.md"],
            "consoleCoding": "utf8"
        },
        {
            "name": "Test Md2FRT",
            "type": "lua",
            "request": "launch",
            "luaVersion": "5.2",
            "stopOnEntry": false,
            "stopOnThreadEntry": false,
            "program": "${workspaceFolder}/tests/wiki.lua",
            "cwd": "${workspaceFolder}/tests",
            "path": "?;?.lua;${workspaceFolder}/?.lua;${workspaceFolder}/src/?.lua",
            "cpath": "${workspaceFolder}/?.dll",
            "arg": ["${workspaceFolder}/tests/wiki.md"],
            "consoleCoding": "utf8"
        },
        {
            "name": "Run Tests",
            "type": "lua",
            "request": "launch",
            "luaVersion": "5.2",
            "stopOnEntry": false,
            "stopOnThreadEntry": false,
            "program": "${workspaceFolder}/tests/fcpu.lua",
            "cwd": "${workspaceFolder}",
            "path": "?;?.lua;${workspaceFolder}/?.lua;${workspaceFolder}/tests/?.lua;${workspaceFolder}/src/?.lua",
            "cpath": "${workspaceFolder}/?.dll",
            "arg": [],
            "consoleCoding": "utf8"
        }
    ]
}